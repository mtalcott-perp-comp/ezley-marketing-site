# Jekyll build artefacts — regenerated on every build, never committed.
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Bundler — `bundle install` writes here; Gemfile.lock IS committed.
.bundle/
vendor/

# Node — reserved for if/when a Tailwind compile step lands later
# (per plan.md L2). Currently unused, but keep ignored to be safe.
node_modules/
package-lock.json
yarn.lock

# Local-only Jekyll config overrides
_config.local.yml

# Editors / OS noise
.DS_Store
.vscode/
.idea/
*.swp
*~

# Generated by some Ruby version managers
.ruby-version.local
